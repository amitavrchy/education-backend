# ─────────────────────────────────────────────────────────────────────────────
# ShikkhaAI API — environment variables
# Copy to .env for local development. Never commit .env.
# Values below are safe local defaults; required ones are marked REQUIRED.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=4000
API_PREFIX=api                       # routes: /<API_PREFIX>/v<API_VERSION>/...
API_VERSION=1
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000   # comma-separated list of allowed origins
TRUST_PROXY=false                    # true behind a reverse proxy / load balancer
SWAGGER_ENABLED=true                 # docs at /api/docs (disable or protect in production)
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace
BODY_SIZE_LIMIT=5mb

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120                   # requests per window per user (or per IP when anonymous)

# ── PostgreSQL (REQUIRED) ────────────────────────────────────────────────────
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://shikkhaai:shikkhaai_dev_password@localhost:5432/shikkhaai?schema=public
# Optional overrides for docker-compose.yml
POSTGRES_USER=shikkhaai
POSTGRES_PASSWORD=shikkhaai_dev_password
POSTGRES_DB=shikkhaai
POSTGRES_PORT=5432

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_PREFIX=shikkhaai
QUEUE_WORKERS_ENABLED=true           # false = this instance only enqueues jobs

# ── JWT (REQUIRED, at least 32 characters each, different in production) ────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=shikkhaai-api
JWT_AUDIENCE=shikkhaai-clients
SESSION_TTL_HOURS=12                 # refresh-session lifetime without "remember me"

# ── Auth / demo mode ─────────────────────────────────────────────────────────
# Demo mode (refused in production): OTP is always 123456, demo accounts accept any password
# except "wrongpass", and POST /auth/switch-role works — what the frontend's demo UI expects.
AUTH_DEMO_MODE=false
SEED_DEMO_PASSWORD=demo-password-123 # password of every seeded demo account (change it in production)
SEED_ON_EMPTY=true                   # first start on an empty database loads the bundled demo data
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local               # local | s3
STORAGE_LOCAL_PATH=./storage         # used when STORAGE_PROVIDER=local
STORAGE_ENDPOINT=                    # S3-compatible endpoint (R2, MinIO, Spaces); empty for AWS
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=shikkhaai-dev
STORAGE_ACCESS_KEY=                  # required only when STORAGE_PROVIDER=s3
STORAGE_SECRET_KEY=
UPLOAD_MAX_FILE_SIZE_MB=25

# ── AI (optional — the API starts without any key) ───────────────────────────
AI_PROVIDER=service                  # none (AI features answer 503) | service (education-ai)
AI_SERVICE_URL=http://localhost:8100 # used when AI_PROVIDER=service
AI_SERVICE_KEY=                      # shared secret, 32+ chars, same value as the AI service's AI_SERVICE_KEY
AI_SERVICE_TIMEOUT_MS=120000

# ── Messaging & payments (optional) ──────────────────────────────────────────
EMAIL_PROVIDER=console               # console (log only) | none
EMAIL_FROM=ShikkhaAI <no-reply@shikkha.ai>
SMS_PROVIDER=console                 # console (log only) | none
PAYMENT_PROVIDER=manual               # manual (bKash/Nagad/Rocket/Upay + admin verification) | mock (demo gateway) | none
