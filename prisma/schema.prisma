// ShikkhaAI — database schema (Prisma ORM 7, PostgreSQL).
//
// Two kinds of storage:
// 1. Normalized security tables: users (credentials), user_sessions, otp_challenges, stored_files.
// 2. A contract store for domain data: `records` holds every entity defined by the frontend's
//    typed contracts (frontend/src/contracts) as JSONB, keyed by (collection, scope, id), and
//    `documents` holds singleton objects (settings, gamification state, usage meters).
//    The frontend contract is the source of truth for those shapes; business rules that must be
//    server-side (scoring, XP, content workflow, billing, quotas, guardian visibility) live in
//    dedicated services, not in the client. See docs/architecture.md.
//
// Conventions: snake_case tables/columns via @@map/@map; createdAt/updatedAt everywhere.
// Large binaries never live in PostgreSQL: StoredFile holds metadata and a storage key.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

/// Authentication identity. The public profile (UserAccount contract) lives in records
/// (collection "users") with the same id; role/status/email/phone are kept in sync.
model User {
  /// Text id so seeded demo ids (e.g. "u-student-1") and generated ids share one format.
  id            String    @id @db.VarChar(120)
  /// Stored lowercased.
  email         String?   @unique @db.VarChar(254)
  /// Normalized local format (01XXXXXXXXX).
  phone         String?   @unique @db.VarChar(20)
  passwordHash  String?   @map("password_hash")
  name          String    @db.VarChar(200)
  /// One of the 10 platform roles (student, parent, teacher, content_reviewer, …).
  role          String    @db.VarChar(40)
  /// active | suspended | pending_deletion | invited
  status        String    @default("active") @db.VarChar(30)
  institutionId String?   @map("institution_id") @db.VarChar(120)
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  sessions      UserSession[]
  uploadedFiles StoredFile[]

  @@index([role])
  @@index([institutionId])
  @@map("users")
}

/// Refresh-token session. Only a SHA-256 hash of the refresh token is stored.
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.VarChar(120)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  remember         Boolean   @default(false)
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// One-time codes for login, registration, password reset and guardian linking.
/// Only a hash of the code is stored; attempts are capped.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  /// login | register | reset | guardian_link
  purpose    String    @db.VarChar(30)
  target     String    @db.VarChar(254)
  codeHash   String    @map("code_hash")
  /// Purpose-specific data (pending registration, remember flag, link id).
  payload    Json?
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([target, purpose])
  @@map("otp_challenges")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contract store
// ─────────────────────────────────────────────────────────────────────────────

/// One entity of a frontend contract type. `collection` is the frontend collection name
/// (e.g. "questions", "examAttempts"); `scope` is "" for global collections or the owning
/// student/user id for per-student ones. ownerId/institutionId are denormalized for access checks.
model Record {
  collection    String   @db.VarChar(80)
  scope         String   @default("") @db.VarChar(120)
  id            String   @db.VarChar(160)
  data          Json
  ownerId       String?  @map("owner_id") @db.VarChar(120)
  institutionId String?  @map("institution_id") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([collection, scope, id])
  @@index([collection, scope, updatedAt])
  @@index([collection, ownerId])
  @@index([collection, institutionId])
  @@map("records")
}

/// Singleton objects keyed by name, e.g. "systemConfig", "gamification:u-student-1".
model Document {
  key       String   @id @db.VarChar(200)
  ownerId   String?  @map("owner_id") @db.VarChar(120)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Files & document processing
// ─────────────────────────────────────────────────────────────────────────────

enum FileCategory {
  BOOK
  PDF
  IMAGE
  NOTE
  VIDEO
  ANSWER_SHEET
  OTHER
}

enum FileVisibility {
  PRIVATE
  INSTITUTION
  PUBLIC
}

enum ProcessingStatus {
  NOT_REQUIRED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

/// Metadata for a binary kept in object storage (local disk or S3-compatible).
model StoredFile {
  id               String           @id @default(uuid()) @db.Uuid
  storageProvider  String           @map("storage_provider") @db.VarChar(20)
  bucket           String           @db.VarChar(100)
  key              String
  originalName     String           @map("original_name")
  mimeType         String           @map("mime_type") @db.VarChar(120)
  sizeBytes        BigInt           @map("size_bytes")
  checksumSha256   String?          @map("checksum_sha256") @db.VarChar(64)
  category         FileCategory
  visibility       FileVisibility   @default(PRIVATE)
  processingStatus ProcessingStatus @default(NOT_REQUIRED) @map("processing_status")
  processingError  String?          @map("processing_error")
  pageCount        Int?             @map("page_count")
  uploadedById     String?          @map("uploaded_by_id") @db.VarChar(120)
  institutionId    String?          @map("institution_id") @db.VarChar(120)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([bucket, key])
  @@index([institutionId, category])
  @@index([processingStatus])
  @@map("stored_files")
}
